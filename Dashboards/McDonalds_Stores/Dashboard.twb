          <alias key='&quot;[federated.1fc7a2m0zd3s4g12d34wc096nqjt].[usr:\% Store Meeting 3 Stars (copy)_2313161382305439748:qk]&quot;' value='2 Stars' />
          <alias key='&quot;[federated.1fc7a2m0zd3s4g12d34wc096nqjt].[usr:\% Store Meeting 4 Stars (copy)_2313161382305046531:qk]&quot;' value='3 Stars' />
          <alias key='&quot;[federated.1fc7a2m0zd3s4g12d34wc096nqjt].[usr:\% Store Meeting 4 Stars (copy)_2313161382309003270:qk]&quot;' value='5 Stars' />
