      <column caption='% Store Meeting 1 Stars' datatype='real' default-format='p0%' name='[% Store Meeting 2 Stars (copy)_2313161382305693701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Less Than 3 Stars (copy)_2313161382296113152] &gt;= 0 AND [Less Than 3 Stars (copy)_2313161382296113152] &lt; 2 THEN 1 ELSE 0 END) / COUNTD([reviewer_id])' />
      </column>
      <column caption='% Store Meeting 2 Stars' datatype='real' default-format='p0%' name='[% Store Meeting 3 Stars (copy)_2313161382305439748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Less Than 3 Stars (copy)_2313161382296113152] &gt;= 2 AND [Less Than 3 Stars (copy)_2313161382296113152] &lt; 3 THEN 1 ELSE 0 END) / COUNTD([reviewer_id])' />
      </column>
      <column caption='% Store Meeting 3 Stars' datatype='real' default-format='p0%' name='[% Store Meeting 4 Stars (copy)_2313161382305046531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Less Than 3 Stars (copy)_2313161382296113152] &gt;= 3 THEN 1 ELSE 0 END) / COUNTD([reviewer_id])' />
      </column>
      <column caption='% Store Meeting 5 Stars' datatype='real' default-format='p0%' name='[% Store Meeting 4 Stars (copy)_2313161382309003270]' role='measure' type='quantitative'>
