      </column>
      <column caption='National Average' datatype='real' name='[Calculation_1434959454909530113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([rating_num]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference From National' datatype='real' name='[Calculation_1434959454909628418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([rating_num]) - WINDOW_AVG(AVG([rating_num]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Less Than 3 Stars' datatype='boolean' name='[Calculation_1434959454911737863]' role='measure' type='nominal'>
        <calculation class='tableau' formula='AVG([rating_num]) &lt; 3' />
      </column>
      <column caption='% Store Meeting 4 Stars' datatype='real' default-format='p0%' name='[Calculation_2313161382303051778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Less Than 3 Stars (copy)_2313161382296113152] &gt;= 4 AND [Less Than 3 Stars (copy)_2313161382296113152] &lt; 5 THEN 1 ELSE 0 END) / COUNTD([reviewer_id])' />
      </column>
      <column caption='Highest' datatype='integer' name='[Calculation_2313161382324899849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [street] : MAX([rating_num]) }' />
      </column>
      <column caption='Z Score' datatype='real' name='[Calculation_2313161382349430802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([rating_num])- WINDOW_AVG( AVG([rating_num]) ))/WINDOW_STDEV( AVG([rating_num]) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Significant Outliers' datatype='boolean' name='[Calculation_2313161382349623315]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ABS([Calculation_2313161382349430802]) &gt;= 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Lowest' datatype='integer' name='[Highest (copy)_2313161382325133322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [street] : MIN([rating_num]) }' />
      </column>
      <column caption='Store Avg Quarter' datatype='real' name='[Less Than 3 Stars (copy)_2313161382296113152]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [reviewer_id] : AVG([rating_num]) }' />
      </column>
