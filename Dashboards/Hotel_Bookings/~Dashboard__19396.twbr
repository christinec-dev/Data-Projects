    <worksheet name='RatesOverTime'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Average Daily Rates  Over Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bookings_final' name='federated.1rg2wtq05xy6sw1f28u8j02wil4o' />
          </datasources>
          <datasource-dependencies datasource='federated.1rg2wtq05xy6sw1f28u8j02wil4o'>
            <column caption='Diff In Daily Rates' datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(AVG([F26])) - LOOKUP(ZN(AVG([F26])), -1)'>
                <table-calc ordering-field='[federated.1rg2wtq05xy6sw1f28u8j02wil4o].[yr:F5:ok]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='avg_daily_rate' datatype='real' name='[F26]' role='measure' type='quantitative' />
