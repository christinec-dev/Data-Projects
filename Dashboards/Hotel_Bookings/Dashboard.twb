      <column caption='Diff In Daily Rates' datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(AVG([F26])) - LOOKUP(ZN(AVG([F26])), -1)'>
          <table-calc ordering-field='[federated.1rg2wtq05xy6sw1f28u8j02wil4o].[yr:F5:ok]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Average stay' datatype='real' name='[Calculation_1331376663835127809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([F10] + [F9])' />
      </column>
      <column caption='weekday' datatype='string' name='[Calculation_1331376663836868611]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Calculation_1364872186057781275])' />
      </column>
      <column caption='Lead Time Buckets' datatype='string' name='[Calculation_1364872186018570240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [F4] &lt;= 7  THEN &apos;0-7 days&apos;&#13;&#10;ELSEIF  [F4] &lt;= 30 THEN &apos;8-30 days&apos;&#13;&#10;ELSEIF  [F4] &lt;= 90 THEN &apos;31-90 days&apos;&#13;&#10;else &apos;90+ days&apos;&#13;&#10;END' />
      </column>
      <column caption='Net ADR' datatype='real' name='[Calculation_1364872186031202316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [F3] = 1 then [F26]* 0.5&#13;&#10;else [F26]&#13;&#10;END' />
      </column>
      <column caption='No Show With Deposit' datatype='integer' name='[Calculation_1364872186034151438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER([F29]) == &apos;No-Show&apos;&#13;&#10;AND  LOWER([F29]) &lt;&gt; &apos;No Deposit&apos;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Total With Deposit' datatype='integer' name='[Calculation_1364872186034454543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER([F29]) &lt;&gt; &apos;No Deposit&apos;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='No-Show Share with Deposit' datatype='real' name='[Calculation_1364872186034692112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1364872186034151438]) / SUM([Calculation_1364872186034454543])' />
      </column>
      <column caption='Length of Stay' datatype='string' name='[Calculation_1364872186038636562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([F10] + [F9]) &gt;= 7 THEN &quot;Long Stay (7+)&quot; ELSE &quot;Short Stay (&lt;7)&quot; END' />
      </column>
      <column caption='RoomType' datatype='string' name='[Calculation_1364872186042404883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [F21] = [F20] THEN &apos;Correct Room&apos; ELSE &apos;Incorrect Room&apos; END' />
      </column>
      <column caption='Is First Timer' datatype='string' name='[Calculation_1364872186046316565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [F18] = 1 THEN &apos;Repeat Guest&apos; ELSE &apos;First Timer&apos; END' />
      </column>
      <column caption='Is cancelled' datatype='integer' name='[Calculation_1364872186049277975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [F3] = 1 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Requested Parking' datatype='string' name='[Calculation_1364872186051330072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [F27] = 0 THEN &apos;Not Requested&apos; ELSE &apos;Requested&apos; END' />
      </column>
      <column caption='Arrival Date' datatype='date' name='[Calculation_1364872186057781275]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATE(STR([F5]) + &apos;-&apos; + STR([F6]) + &apos;-&apos; + STR([F8])))' />
      </column>
      <column caption='Next 90 Days' datatype='boolean' name='[Calculation_1364872186058215453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Calculation_1364872186057781275]) &gt;= 0&#13;&#10;AND DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 1], [Calculation_1364872186057781275]) &lt;= 90' />
      </column>
