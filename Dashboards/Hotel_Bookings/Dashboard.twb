              <calculation class='tableau' formula='IF [F4] &lt;= 7  THEN &apos;0-7 days&apos;&#13;&#10;ELSEIF  [F4] &lt;= 30 THEN &apos;8-30 days&apos;&#13;&#10;ELSEIF  [F4] &lt;= 90 THEN &apos;31-90 days&apos;&#13;&#10;else &apos;90+ days&apos;&#13;&#10;END' />
